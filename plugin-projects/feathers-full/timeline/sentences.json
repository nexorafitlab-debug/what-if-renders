[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.04,
  "text": "Monday morning."
 },
 {
  "i": 1,
  "start": 1.5,
  "end": 2.58,
  "text": "Your mom stands in the kitchen."
 },
 {
  "i": 2,
  "start": 3.36,
  "end": 3.96,
  "text": "Did you do your homework?"
 },
 {
  "i": 3,
  "start": 4.56,
  "end": 5.06,
  "text": "You did not."
 },
 {
  "i": 4,
  "start": 5.54,
  "end": 6.58,
  "text": "You played games till midnight."
 },
 {
  "i": 5,
  "start": 7.38,
  "end": 10.14,
  "text": "You say \"Yes.\" And something moves on your wrist..."
 },
 {
  "i": 6,
  "start": 10.7,
  "end": 11.02,
  "text": "A feather."
 },
 {
  "i": 7,
  "start": 11.58,
  "end": 11.88,
  "text": "Small."
 },
 {
  "i": 8,
  "start": 12.46,
  "end": 12.68,
  "text": "White."
 },
 {
  "i": 9,
  "start": 13.3,
  "end": 13.48,
  "text": "Pop."
 },
 {
  "i": 10,
  "start": 14.12,
  "end": 15.82,
  "text": "It pushes out of your skin like a sprout."
 },
 {
  "i": 11,
  "start": 16.7,
  "end": 17.82,
  "text": "You pull your sleeve down."
 },
 {
  "i": 12,
  "start": 18.22,
  "end": 18.54,
  "text": "Fast."
 },
 {
  "i": 13,
  "start": 19.18,
  "end": 19.84,
  "text": "Your name is Kai."
 },
 {
  "i": 14,
  "start": 20.34,
  "end": 20.94,
  "text": "You are sixteen."
 },
 {
  "i": 15,
  "start": 21.7,
  "end": 23.66,
  "text": "And every lie you tell grows a feather."
 },
 {
  "i": 16,
  "start": 24.3,
  "end": 26.48,
  "text": "A small lie grows a small white feather."
 },
 {
  "i": 17,
  "start": 27.02,
  "end": 29.12,
  "text": "A big lie grows a big black one."
 },
 {
  "i": 18,
  "start": 29.74,
  "end": 31.14,
  "text": "It grows in one second..."
 },
 {
  "i": 19,
  "start": 32.12,
  "end": 33.64,
  "text": "Right where everyone can see it."
 },
 {
  "i": 20,
  "start": 33.98,
  "end": 35.08,
  "text": "You cannot pull it out."
 },
 {
  "i": 21,
  "start": 35.52,
  "end": 35.94,
  "text": "It hurts..."
 },
 {
  "i": 22,
  "start": 36.54,
  "end": 37.28,
  "text": "And it grows back."
 },
 {
  "i": 23,
  "start": 38.0,
  "end": 38.24,
  "text": "Bigger."
 },
 {
  "i": 24,
  "start": 38.96,
  "end": 39.68,
  "text": "Can you stop it?"
 },
 {
  "i": 25,
  "start": 40.22,
  "end": 42.46,
  "text": "The only way to lose a feather is to tell the truth."
 },
 {
  "i": 26,
  "start": 43.06,
  "end": 43.82,
  "text": "Say it out loud..."
 },
 {
  "i": 27,
  "start": 44.42,
  "end": 45.24,
  "text": "And the feather falls."
 },
 {
  "i": 28,
  "start": 45.88,
  "end": 46.72,
  "text": "It floats away."
 },
 {
  "i": 29,
  "start": 47.56,
  "end": 49.12,
  "text": "You cannot see anyone else's."
 },
 {
  "i": 30,
  "start": 49.44,
  "end": 49.96,
  "text": "Only yours."
 },
 {
  "i": 31,
  "start": 50.54,
  "end": 51.1,
  "text": "That is the rule."
 },
 {
  "i": 32,
  "start": 51.8,
  "end": 53.92,
  "text": "So what if every lie you tell grows a feather?"
 },
 {
  "i": 33,
  "start": 57.98,
  "end": 59.04,
  "text": "At school, Mr."
 },
 {
  "i": 34,
  "start": 59.2,
  "end": 61.02,
  "text": "Okafor hands back the maths test."
 },
 {
  "i": 35,
  "start": 61.8,
  "end": 62.44,
  "text": "You got a forty."
 },
 {
  "i": 36,
  "start": 62.92,
  "end": 63.44,
  "text": "He asks."
 },
 {
  "i": 37,
  "start": 64.24,
  "end": 64.76,
  "text": "Did you study?"
 },
 {
  "i": 38,
  "start": 65.78,
  "end": 66.12,
  "text": "\"Yes."
 },
 {
  "i": 39,
  "start": 66.68,
  "end": 69.62,
  "text": "All weekend.\" A white feather pops out of your collar..."
 },
 {
  "i": 40,
  "start": 70.48,
  "end": 71.04,
  "text": "Can you feel it?"
 },
 {
  "i": 41,
  "start": 71.6,
  "end": 72.58,
  "text": "You tug your hood up."
 },
 {
  "i": 42,
  "start": 73.2,
  "end": 76.38,
  "text": "At lunch, Danny, your best friend since you were six, asks."
 },
 {
  "i": 43,
  "start": 77.1,
  "end": 77.74,
  "text": "Do you like Maya?"
 },
 {
  "i": 44,
  "start": 78.58,
  "end": 79.0,
  "text": "You do."
 },
 {
  "i": 45,
  "start": 79.68,
  "end": 80.78,
  "text": "You have liked her for a year."
 },
 {
  "i": 46,
  "start": 81.68,
  "end": 82.04,
  "text": "\"No."
 },
 {
  "i": 47,
  "start": 82.44,
  "end": 85.34,
  "text": "She is just a friend.\" A feather grows on your hand."
 },
 {
  "i": 48,
  "start": 85.82,
  "end": 86.86,
  "text": "You hide it under the table..."
 },
 {
  "i": 49,
  "start": 87.82,
  "end": 88.46,
  "text": "Maya sits down."
 },
 {
  "i": 50,
  "start": 89.06,
  "end": 89.68,
  "text": "Nice hoodie, Kai."
 },
 {
  "i": 51,
  "start": 90.44,
  "end": 90.76,
  "text": "\"Thanks."
 },
 {
  "i": 52,
  "start": 91.36,
  "end": 93.28,
  "text": "It was cheap.\" It was not cheap."
 },
 {
  "i": 53,
  "start": 93.86,
  "end": 95.12,
  "text": "Your mom saved for a month."
 },
 {
  "i": 54,
  "start": 95.8,
  "end": 97.1,
  "text": "A feather grows on your neck."
 },
 {
  "i": 55,
  "start": 98.14,
  "end": 99.66,
  "text": "By the end of lunch, you count them..."
 },
 {
  "i": 56,
  "start": 100.36,
  "end": 100.48,
  "text": "Four."
 },
 {
  "i": 57,
  "start": 100.92,
  "end": 101.96,
  "text": "Four white feathers."
 },
 {
  "i": 58,
  "start": 102.82,
  "end": 103.52,
  "text": "Can you count them?"
 },
 {
  "i": 59,
  "start": 104.18,
  "end": 104.44,
  "text": "Wrist."
 },
 {
  "i": 60,
  "start": 104.98,
  "end": 105.06,
  "text": "Collar."
 },
 {
  "i": 61,
  "start": 105.54,
  "end": 105.84,
  "text": "Hand."
 },
 {
  "i": 62,
  "start": 106.36,
  "end": 106.6,
  "text": "Neck."
 },
 {
  "i": 63,
  "start": 107.48,
  "end": 109.2,
  "text": "That night, you stand in front of the mirror."
 },
 {
  "i": 64,
  "start": 109.2,
  "end": 110.38,
  "text": "You count again..."
 },
 {
  "i": 65,
  "start": 111.5,
  "end": 111.5,
  "text": "Four."
 },
 {
  "i": 66,
  "start": 112.32,
  "end": 113.08,
  "text": "You whisper to yourself."
 },
 {
  "i": 67,
  "start": 113.88,
  "end": 116.16,
  "text": "\"I am fine.\" You are not fine."
 },
 {
  "i": 68,
  "start": 117.18,
  "end": 118.58,
  "text": "A feather grows on your chest..."
 },
 {
  "i": 69,
  "start": 119.08,
  "end": 119.8,
  "text": "Right over your heart."
 },
 {
  "i": 70,
  "start": 120.52,
  "end": 121.22,
  "text": "And that counts too."
 },
 {
  "i": 71,
  "start": 121.98,
  "end": 122.82,
  "text": "Five feathers now..."
 },
 {
  "i": 72,
  "start": 123.22,
  "end": 124.3,
  "text": "all from one day."
 },
 {
  "i": 73,
  "start": 128.04,
  "end": 129.72,
  "text": "The next day, you try something new."
 },
 {
  "i": 74,
  "start": 130.34,
  "end": 130.9,
  "text": "No lies."
 },
 {
  "i": 75,
  "start": 131.4,
  "end": 131.9,
  "text": "Not one."
 },
 {
  "i": 76,
  "start": 132.42,
  "end": 133.12,
  "text": "Your mom asks."
 },
 {
  "i": 77,
  "start": 133.64,
  "end": 134.02,
  "text": "Are you hungry?"
 },
 {
  "i": 78,
  "start": 134.66,
  "end": 135.2,
  "text": "You say yes."
 },
 {
  "i": 79,
  "start": 136.14,
  "end": 136.74,
  "text": "No feather."
 },
 {
  "i": 80,
  "start": 137.3,
  "end": 138.06,
  "text": "Your teacher asks."
 },
 {
  "i": 81,
  "start": 138.06,
  "end": 139.24,
  "text": "Do you understand?"
 },
 {
  "i": 82,
  "start": 139.98,
  "end": 140.48,
  "text": "You do not."
 },
 {
  "i": 83,
  "start": 141.18,
  "end": 141.74,
  "text": "You say no."
 },
 {
  "i": 84,
  "start": 142.3,
  "end": 142.82,
  "text": "No feather."
 },
 {
  "i": 85,
  "start": 143.78,
  "end": 144.18,
  "text": "Danny asks."
 },
 {
  "i": 86,
  "start": 144.78,
  "end": 145.56,
  "text": "Are you mad at me?"
 },
 {
  "i": 87,
  "start": 146.16,
  "end": 146.68,
  "text": "You are."
 },
 {
  "i": 88,
  "start": 147.24,
  "end": 147.92,
  "text": "You say yes."
 },
 {
  "i": 89,
  "start": 148.62,
  "end": 149.34,
  "text": "He says sorry."
 },
 {
  "i": 90,
  "start": 150.0,
  "end": 150.54,
  "text": "No feather."
 },
 {
  "i": 91,
  "start": 151.4,
  "end": 152.2,
  "text": "One whole morning."
 },
 {
  "i": 92,
  "start": 152.66,
  "end": 153.62,
  "text": "Not one new feather."
 },
 {
  "i": 93,
  "start": 154.2,
  "end": 154.92,
  "text": "You feel light."
 },
 {
  "i": 94,
  "start": 155.94,
  "end": 157.14,
  "text": "Lighter than you have in days."
 },
 {
  "i": 95,
  "start": 158.0,
  "end": 158.76,
  "text": "Then the bell rings..."
 },
 {
  "i": 96,
  "start": 159.12,
  "end": 160.48,
  "text": "And it all falls apart."
 },
 {
  "i": 97,
  "start": 161.4,
  "end": 162.66,
  "text": "Danny broke the coach's window."
 },
 {
  "i": 98,
  "start": 163.14,
  "end": 163.58,
  "text": "A football."
 },
 {
  "i": 99,
  "start": 163.58,
  "end": 164.86,
  "text": "Straight through the glass."
 },
 {
  "i": 100,
  "start": 165.44,
  "end": 166.36,
  "text": "The coach is shouting."
 },
 {
  "i": 101,
  "start": 166.36,
  "end": 167.64,
  "text": "Who did this?"
 },
 {
  "i": 102,
  "start": 168.4,
  "end": 169.3,
  "text": "Everyone looks at Danny."
 },
 {
  "i": 103,
  "start": 170.1,
  "end": 170.9,
  "text": "Danny looks at you."
 },
 {
  "i": 104,
  "start": 171.94,
  "end": 172.86,
  "text": "You know what he wants."
 },
 {
  "i": 105,
  "start": 173.42,
  "end": 174.18,
  "text": "You open your mouth."
 },
 {
  "i": 106,
  "start": 174.7,
  "end": 176.46,
  "text": "\"It was me.\" It was not you."
 },
 {
  "i": 107,
  "start": 176.78,
  "end": 177.36,
  "text": "It was him."
 },
 {
  "i": 108,
  "start": 177.94,
  "end": 178.82,
  "text": "And a feather grows."
 },
 {
  "i": 109,
  "start": 179.48,
  "end": 180.06,
  "text": "Not white."
 },
 {
  "i": 110,
  "start": 180.54,
  "end": 180.96,
  "text": "Black."
 },
 {
  "i": 111,
  "start": 181.5,
  "end": 181.86,
  "text": "Huge."
 },
 {
  "i": 112,
  "start": 182.66,
  "end": 183.88,
  "text": "It bursts out of your shoulder..."
 },
 {
  "i": 113,
  "start": 184.46,
  "end": 185.78,
  "text": "It is as long as your hand."
 },
 {
  "i": 114,
  "start": 186.4,
  "end": 187.44,
  "text": "Everyone sees it."
 },
 {
  "i": 115,
  "start": 188.24,
  "end": 189.0,
  "text": "The coach stares."
 },
 {
  "i": 116,
  "start": 189.72,
  "end": 189.8,
  "text": "Kai."
 },
 {
  "i": 117,
  "start": 190.42,
  "end": 190.96,
  "text": "My office."
 },
 {
  "i": 118,
  "start": 191.66,
  "end": 191.76,
  "text": "Now."
 },
 {
  "i": 119,
  "start": 192.32,
  "end": 193.28,
  "text": "You sit in his office."
 },
 {
  "i": 120,
  "start": 193.76,
  "end": 195.42,
  "text": "The black feather hangs over your shirt."
 },
 {
  "i": 121,
  "start": 195.94,
  "end": 196.96,
  "text": "The coach asks again."
 },
 {
  "i": 122,
  "start": 197.58,
  "end": 198.52,
  "text": "Did you really break it?"
 },
 {
  "i": 123,
  "start": 199.08,
  "end": 200.68,
  "text": "You look at Danny, waiting outside."
 },
 {
  "i": 124,
  "start": 201.38,
  "end": 203.48,
  "text": "If you tell the truth, Danny gets suspended."
 },
 {
  "i": 125,
  "start": 204.5,
  "end": 205.4,
  "text": "He misses the final."
 },
 {
  "i": 126,
  "start": 205.92,
  "end": 207.6,
  "text": "If you keep lying, the feather stays."
 },
 {
  "i": 127,
  "start": 208.12,
  "end": 209.06,
  "text": "And more will come."
 },
 {
  "i": 128,
  "start": 209.58,
  "end": 212.44,
  "text": "Because one lie always needs another lie to hold it up."
 },
 {
  "i": 129,
  "start": 213.08,
  "end": 213.78,
  "text": "You take a breath..."
 },
 {
  "i": 130,
  "start": 214.44,
  "end": 214.78,
  "text": "\"No."
 },
 {
  "i": 131,
  "start": 215.06,
  "end": 215.64,
  "text": "It was Danny."
 },
 {
  "i": 132,
  "start": 216.04,
  "end": 218.5,
  "text": "I lied to protect him.\" And the feather falls."
 },
 {
  "i": 133,
  "start": 219.08,
  "end": 220.32,
  "text": "It turns white."
 },
 {
  "i": 134,
  "start": 220.44,
  "end": 221.62,
  "text": "Then it floats away..."
 },
 {
  "i": 135,
  "start": 222.28,
  "end": 222.86,
  "text": "Out the window."
 },
 {
  "i": 136,
  "start": 223.46,
  "end": 223.86,
  "text": "Like snow."
 },
 {
  "i": 137,
  "start": 224.8,
  "end": 225.44,
  "text": "The coach nods."
 },
 {
  "i": 138,
  "start": 226.22,
  "end": 227.38,
  "text": "Thank you for telling the truth, Kai."
 },
 {
  "i": 139,
  "start": 228.38,
  "end": 229.88,
  "text": "Danny gets two weeks of cleaning the gym."
 },
 {
  "i": 140,
  "start": 230.48,
  "end": 231.08,
  "text": "Not suspended."
 },
 {
  "i": 141,
  "start": 231.74,
  "end": 232.18,
  "text": "Just cleaning."
 },
 {
  "i": 142,
  "start": 232.94,
  "end": 233.66,
  "text": "Was it worth it?"
 },
 {
  "i": 143,
  "start": 234.12,
  "end": 234.76,
  "text": "You walk out."
 },
 {
  "i": 144,
  "start": 235.36,
  "end": 235.94,
  "text": "Danny is waiting."
 },
 {
  "i": 145,
  "start": 236.76,
  "end": 237.84,
  "text": "He looks at your shoulder."
 },
 {
  "i": 146,
  "start": 238.42,
  "end": 239.18,
  "text": "The feather is gone."
 },
 {
  "i": 147,
  "start": 240.0,
  "end": 241.94,
  "text": "\"You told him?\" You nod."
 },
 {
  "i": 148,
  "start": 242.76,
  "end": 246.5,
  "text": "\"I thought you would keep lying for me.\" \"I did lie for you,\" you say."
 },
 {
  "i": 149,
  "start": 246.5,
  "end": 249.12,
  "text": "\"Look what it grew.\" He laughs."
 },
 {
  "i": 150,
  "start": 249.94,
  "end": 252.66,
  "text": "\"You look like a bird, man.\" \"I know,\" you say."
 },
 {
  "i": 151,
  "start": 253.26,
  "end": 259.08,
  "text": "\"I am working on it.\" Is any of this real?"
 },
 {
  "i": 152,
  "start": 259.74,
  "end": 260.72,
  "text": "The feathers are fiction."
 },
 {
  "i": 153,
  "start": 261.22,
  "end": 262.24,
  "text": "The lying is not."
 },
 {
  "i": 154,
  "start": 262.98,
  "end": 265.54,
  "text": "Psychologist Bella DePaulo studied lying for years."
 },
 {
  "i": 155,
  "start": 266.14,
  "end": 268.56,
  "text": "She found that most people tell one or two lies a day."
 },
 {
  "i": 156,
  "start": 269.52,
  "end": 270.1,
  "text": "Small ones."
 },
 {
  "i": 157,
  "start": 270.64,
  "end": 275.14,
  "text": "\"I am fine.\" \"I am on my way.\" We lie so often, we stop noticing."
 },
 {
  "i": 158,
  "start": 275.96,
  "end": 276.98,
  "text": "Does that sound like your day?"
 },
 {
  "i": 159,
  "start": 277.72,
  "end": 279.42,
  "text": "And lying is hard work for your brain."
 },
 {
  "i": 160,
  "start": 280.06,
  "end": 281.14,
  "text": "A true answer is simple."
 },
 {
  "i": 161,
  "start": 281.58,
  "end": 282.48,
  "text": "You just remember it."
 },
 {
  "i": 162,
  "start": 283.02,
  "end": 284.12,
  "text": "A lie needs building."
 },
 {
  "i": 163,
  "start": 284.92,
  "end": 286.12,
  "text": "You have to invent it."
 },
 {
  "i": 164,
  "start": 286.36,
  "end": 286.98,
  "text": "Remember it."
 },
 {
  "i": 165,
  "start": 287.14,
  "end": 288.8,
  "text": "And keep it from crashing into the truth."
 },
 {
  "i": 166,
  "start": 289.56,
  "end": 292.26,
  "text": "Your brain lights up more when you lie than when you tell the truth."
 },
 {
  "i": 167,
  "start": 292.78,
  "end": 294.12,
  "text": "And your body gives you away too."
 },
 {
  "i": 168,
  "start": 294.9,
  "end": 297.5,
  "text": "In Spain, researchers found the Pinocchio effect."
 },
 {
  "i": 169,
  "start": 298.16,
  "end": 300.98,
  "text": "When people lie, the temperature of their nose drops..."
 },
 {
  "i": 170,
  "start": 301.7,
  "end": 302.1,
  "text": "Just a little."
 },
 {
  "i": 171,
  "start": 302.66,
  "end": 303.66,
  "text": "Your nose gets colder."
 },
 {
  "i": 172,
  "start": 304.22,
  "end": 304.84,
  "text": "Like Pinocchio."
 },
 {
  "i": 173,
  "start": 305.52,
  "end": 306.0,
  "text": "Only real."
 },
 {
  "i": 174,
  "start": 307.04,
  "end": 308.12,
  "text": "Lying raises your stress."
 },
 {
  "i": 175,
  "start": 308.72,
  "end": 309.78,
  "text": "Your heart beats faster."
 },
 {
  "i": 176,
  "start": 310.26,
  "end": 311.04,
  "text": "Your hands sweat."
 },
 {
  "i": 177,
  "start": 311.78,
  "end": 314.0,
  "text": "That is why lie detectors do not detect lies."
 },
 {
  "i": 178,
  "start": 314.64,
  "end": 315.5,
  "text": "They detect stress."
 },
 {
  "i": 179,
  "start": 316.7,
  "end": 318.78,
  "text": "Every lie you tell is weight you carry."
 },
 {
  "i": 180,
  "start": 319.38,
  "end": 320.82,
  "text": "You just cannot see it..."
 },
 {
  "i": 181,
  "start": 321.18,
  "end": 321.96,
  "text": "Unless you are Kai."
 },
 {
  "i": 182,
  "start": 322.58,
  "end": 323.32,
  "text": "Then you can."
 },
 {
  "i": 183,
  "start": 324.32,
  "end": 326.28,
  "text": "That night, you stand in the mirror again."
 },
 {
  "i": 184,
  "start": 327.16,
  "end": 328.46,
  "text": "Five white feathers are left."
 },
 {
  "i": 185,
  "start": 328.9,
  "end": 329.58,
  "text": "All small."
 },
 {
  "i": 186,
  "start": 330.12,
  "end": 330.78,
  "text": "All from yesterday."
 },
 {
  "i": 187,
  "start": 331.64,
  "end": 332.64,
  "text": "You say them out loud."
 },
 {
  "i": 188,
  "start": 333.54,
  "end": 334.26,
  "text": "One by one."
 },
 {
  "i": 189,
  "start": 334.76,
  "end": 335.44,
  "text": "The true version."
 },
 {
  "i": 190,
  "start": 336.1,
  "end": 337.02,
  "text": "\"I am not fine."
 },
 {
  "i": 191,
  "start": 337.42,
  "end": 339.5,
  "text": "I am scared.\" The feather falls."
 },
 {
  "i": 192,
  "start": 340.26,
  "end": 341.06,
  "text": "\"It was not cheap."
 },
 {
  "i": 193,
  "start": 341.64,
  "end": 343.9,
  "text": "My mom saved for it.\" The feather falls."
 },
 {
  "i": 194,
  "start": 344.62,
  "end": 345.34,
  "text": "\"I like Maya."
 },
 {
  "i": 195,
  "start": 345.84,
  "end": 348.16,
  "text": "I have liked her for a year.\" The feather falls."
 },
 {
  "i": 196,
  "start": 348.96,
  "end": 349.7,
  "text": "\"I did not study."
 },
 {
  "i": 197,
  "start": 350.66,
  "end": 352.78,
  "text": "I played games.\" Two feathers fall."
 },
 {
  "i": 198,
  "start": 353.3,
  "end": 353.88,
  "text": "Wrist and collar."
 },
 {
  "i": 199,
  "start": 354.3,
  "end": 354.88,
  "text": "Five feathers."
 },
 {
  "i": 200,
  "start": 355.44,
  "end": 356.24,
  "text": "Floating to the floor..."
 },
 {
  "i": 201,
  "start": 356.78,
  "end": 357.44,
  "text": "Then out the window."
 },
 {
  "i": 202,
  "start": 358.08,
  "end": 358.52,
  "text": "Like snow."
 },
 {
  "i": 203,
  "start": 358.96,
  "end": 359.6,
  "text": "You feel lighter."
 },
 {
  "i": 204,
  "start": 360.12,
  "end": 361.58,
  "text": "You sleep better than you have in weeks."
 },
 {
  "i": 205,
  "start": 365.36,
  "end": 367.6,
  "text": "The next morning, you tell Maya the truth."
 },
 {
  "i": 206,
  "start": 368.06,
  "end": 368.64,
  "text": "At her locker."
 },
 {
  "i": 207,
  "start": 369.56,
  "end": 370.56,
  "text": "In front of everyone."
 },
 {
  "i": 208,
  "start": 371.34,
  "end": 372.06,
  "text": "\"I like you."
 },
 {
  "i": 209,
  "start": 372.5,
  "end": 373.6,
  "text": "I have liked you for a year."
 },
 {
  "i": 210,
  "start": 374.18,
  "end": 377.84,
  "text": "I lied yesterday because I was scared.\" She stares at you."
 },
 {
  "i": 211,
  "start": 378.36,
  "end": 379.04,
  "text": "Then she smiles..."
 },
 {
  "i": 212,
  "start": 380.0,
  "end": 381.3,
  "text": "\"I know,\" she says."
 },
 {
  "i": 213,
  "start": 382.02,
  "end": 384.72,
  "text": "\"You had a feather on your hand.\" You laugh."
 },
 {
  "i": 214,
  "start": 385.74,
  "end": 386.22,
  "text": "She laughs."
 },
 {
  "i": 215,
  "start": 386.76,
  "end": 387.68,
  "text": "And no feather grows."
 },
 {
  "i": 216,
  "start": 388.42,
  "end": 390.26,
  "text": "Because this time, it is true."
 },
 {
  "i": 217,
  "start": 391.26,
  "end": 392.14,
  "text": "So what would you do?"
 },
 {
  "i": 218,
  "start": 392.14,
  "end": 396.22,
  "text": "If every lie grew a feather, how many would you be wearing right now?"
 },
 {
  "i": 219,
  "start": 396.86,
  "end": 397.14,
  "text": "One."
 },
 {
  "i": 220,
  "start": 397.58,
  "end": 397.88,
  "text": "Ten."
 },
 {
  "i": 221,
  "start": 398.48,
  "end": 398.82,
  "text": "A hundred."
 },
 {
  "i": 222,
  "start": 399.48,
  "end": 401.34,
  "text": "And which lie would you take back first?"
 },
 {
  "i": 223,
  "start": 402.28,
  "end": 403.12,
  "text": "Tell us in the comments."
 },
 {
  "i": 224,
  "start": 403.12,
  "end": 404.6,
  "text": "And if this one hit you..."
 },
 {
  "i": 225,
  "start": 405.0,
  "end": 407.28,
  "text": "hit like, and subscribe for more What Ifs."
 }
]